{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "lazygitrs configuration (lazygit-compatible). Generated from the built-in defaults; regenerate with `lazygitrs --print-config-schema`.",
  "properties": {
    "aiNotes": {
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "customCommands": {
      "default": [],
      "items": {
        "properties": {
          "command": {
            "default": "",
            "type": "string"
          },
          "context": {
            "default": "",
            "type": "string"
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "key": {
            "default": "",
            "type": "string"
          },
          "prompts": {
            "default": [
              {
                "command": "",
                "filter": "",
                "key": "",
                "title": "",
                "type": ""
              }
            ],
            "items": {
              "properties": {
                "command": {
                  "default": "",
                  "type": "string"
                },
                "filter": {
                  "default": "",
                  "type": "string"
                },
                "key": {
                  "default": "",
                  "type": "string"
                },
                "title": {
                  "default": "",
                  "type": "string"
                },
                "type": {
                  "default": "",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "showOutput": {
            "default": false,
            "type": "boolean"
          },
          "stream": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "context",
          "command",
          "description"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "git": {
      "properties": {
        "autoFetch": {
          "default": true,
          "type": "boolean"
        },
        "autoRefresh": {
          "default": true,
          "type": "boolean"
        },
        "branchLogCmd": {
          "default": "git log --graph --color=always --abbrev-commit --decorate --date=relative --pretty=medium {{branchName}} --",
          "type": "string"
        },
        "commit": {
          "properties": {
            "autoWrapCommitMessage": {
              "default": true,
              "type": "boolean"
            },
            "autoWrapWidth": {
              "default": 72,
              "type": "integer"
            },
            "generateCommand": {
              "default": "",
              "type": "string"
            },
            "signOff": {
              "default": false,
              "type": "boolean"
            },
            "smartCommitCommand": {
              "default": "",
              "type": "string"
            },
            "smartCommitGranularity": {
              "default": "medium",
              "type": "string"
            }
          },
          "type": "object"
        },
        "merging": {
          "properties": {
            "args": {
              "default": "",
              "type": "string"
            },
            "manualCommit": {
              "default": false,
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "paging": {
          "properties": {
            "useConfig": {
              "default": false,
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "gui": {
      "properties": {
        "border": {
          "default": "rounded",
          "description": "Border style for all panels, or a map of panel name to style",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          ]
        },
        "borderGradient": {
          "default": "",
          "type": "string"
        },
        "fileHeaderSeparatorChar": {
          "default": "─",
          "type": "string"
        },
        "mouseEvents": {
          "default": true,
          "type": "boolean"
        },
        "nerdFontsVersion": {
          "default": "3",
          "type": "string"
        },
        "outerFrame": {
          "default": false,
          "type": "boolean"
        },
        "scrollHeight": {
          "default": 2,
          "type": "integer"
        },
        "scrollPastBottom": {
          "default": true,
          "type": "boolean"
        },
        "showBottomLine": {
          "default": true,
          "type": "boolean"
        },
        "showCommandLog": {
          "default": true,
          "type": "boolean"
        },
        "showFileTree": {
          "default": true,
          "type": "boolean"
        },
        "sideBySide": {
          "default": true,
          "type": "boolean"
        },
        "sidePanelWidth": {
          "default": 0.3333,
          "type": "number"
        },
        "skipDiscardChangeWarning": {
          "default": false,
          "type": "boolean"
        },
        "spinner": {
          "default": [
            "·",
            "✻",
            "✽",
            "✶",
            "✳",
            "✢"
          ],
          "items": {
            "default": "·",
            "type": "string"
          },
          "type": "array"
        },
        "theme": {
          "description": "Theme preset name (e.g. `omarchy`, `cockpit`) or a lazygit color map",
          "oneOf": [
            {
              "description": "Theme preset name",
              "type": "string"
            },
            {
              "properties": {
                "activeBorderColor": {
                  "default": [
                    "green"
                  ],
                  "items": {
                    "default": "green",
                    "type": "string"
                  },
                  "type": "array"
                },
                "inactiveBorderColor": {
                  "default": [
                    "default"
                  ],
                  "items": {
                    "default": "default",
                    "type": "string"
                  },
                  "type": "array"
                },
                "optionsTextColor": {
                  "default": [
                    "blue"
                  ],
                  "items": {
                    "default": "blue",
                    "type": "string"
                  },
                  "type": "array"
                },
                "preset": {
                  "description": "Theme preset name",
                  "type": "string"
                },
                "selectedLineBgColor": {
                  "default": [
                    "blue"
                  ],
                  "items": {
                    "default": "blue",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          ]
        }
      },
      "type": "object"
    },
